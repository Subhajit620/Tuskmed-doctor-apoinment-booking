# ---- Core ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-super-secret
SESSION_COOKIE_NAME=tuskmed_session

# ---- Database ----
# Local docker-compose exposes Postgres on 5433
DATABASE_URL=postgresql://tuskmed:tuskmed@localhost:5433/tuskmed?schema=public

# A SEPARATE database for the Jest suite (tests/setupEnv.js points
# DATABASE_URL at this instead) - keeps `npm test` from ever writing
# fixture data into your dev/demo database. Create it once with:
#   docker exec tuskmed_db psql -U tuskmed -d tuskmed -c "CREATE DATABASE tuskmed_test;"
#   npm run prisma:deploy -- --schema=./prisma/schema.prisma   (with DATABASE_URL below)
TEST_DATABASE_URL=postgresql://tuskmed:tuskmed@localhost:5433/tuskmed_test?schema=public

# ---- Integration mode ----
# When true, all four external integrations use built-in mocks (no real
# credentials required). This is the global default; each integration below
# can be overridden individually (e.g. set MOCK_WHATSAPP=false to send real
# OTPs on WhatsApp while payment/video/storage stay safely mocked).
MOCK_INTEGRATIONS=true
# MOCK_WHATSAPP=false
# MOCK_PAYMENT=false
# MOCK_VIDEO=false
# MOCK_STORAGE=false

# ---- 1a) WhatsApp OTP delivery - AiSensy (current provider for OTP) ----
# Uses the existing, already-LIVE AiSensy "Tuskmed" project - do not create a
# new AiSensy project. AISENSY_API_KEY is the project's API key (Manage >
# API Keys in the AiSensy dashboard); never commit the real value.
# AISENSY_CAMPAIGN_NAME is the name of the API Campaign built on top of the
# approved `tuskmed_otp` Authentication template (category AUTHENTICATION,
# Copy Code button enabled) - NOT necessarily the same string as the
# template name. See server/src/integrations/aisensy.js for status: the
# live API call is not wired up yet pending the campaign's exact generated
# request format.
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=
AISENSY_APPT_CAMPAIGN_NAME=
AISENSY_DOCTOR_APPT_CAMPAIGN_NAME=
AISENSY_REMINDER_CAMPAIGN_NAME=
AISENSY_DOCTOR_REMINDER_CAMPAIGN_NAME=

# ---- 1b) WhatsApp Business messaging (Meta Cloud API) ----
# STILL USED for appointment confirmations/reminders (integrations/whatsapp.js).
# No longer used for OTP - that now goes through AiSensy above.
# Meta WhatsApp Cloud API. Get these from developers.facebook.com:
#   1. Create a Meta developer account + an App with the "WhatsApp" product added.
#   2. The App's WhatsApp > API Setup page gives you a temporary access token
#      (valid 24h - fine for testing) and a test WHATSAPP_PHONE_NUMBER_ID.
#   3. On that same page, add the phone number(s) you'll send OTPs to under
#      "To" as a recipient - Meta's test numbers can only message allow-listed
#      recipients until the app goes through Business Verification.
#   4. sendOtp() always uses an approved "Authentication" template (below),
#      since that's the one message type Meta delivers outside the 24h
#      session window - free-form text (used for confirmations/reminders)
#      still needs the recipient to have messaged your number recently.
#   5. For production, exchange the temporary token for a permanent one via
#      a System User (Meta Business Settings > System Users).
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
# Must match an approved template in WhatsApp Manager > Message Templates
# (category: Authentication) - name + language code exactly as approved.
WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
WHATSAPP_OTP_TEMPLATE_LANG=en

# ---- 2) Payment gateway (Razorpay) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# ---- 3) WebRTC video calling (Daily.co) ----
DAILY_API_KEY=
DAILY_DOMAIN=tuskmed.daily.co

# ---- 4) Cloud file storage (S3-compatible) ----
STORAGE_PROVIDER=s3
S3_BUCKET=tuskmed-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- Business rules ----
SLOT_LOCK_MINUTES=10
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
JOIN_CALL_WINDOW_MINUTES_BEFORE=10

# ---- 5) Doctor dashboard "Ask Gen AI" (bonus, beyond the 4 required integrations) ----
# Optional. Leave blank to keep this screen in sandbox mode (canned response).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# MOCK_GEN_AI=false
